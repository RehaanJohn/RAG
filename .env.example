# =============================================================================
# RAG System — Environment Variables
# Copy to .env and fill in the required values before running.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (self-hosted Supabase Postgres)
# -----------------------------------------------------------------------------

# asyncpg DSN used by the FastAPI app and the arq worker.
# For Docker Compose: postgresql://postgres:<POSTGRES_PASSWORD>@supabase-db:5432/postgres
DATABASE_URL=postgresql://postgres:supabase_local_pass@supabase-db:5432/postgres

# Postgres credentials (also read by the supabase-db Docker service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=supabase_local_pass
POSTGRES_DB=postgres

# -----------------------------------------------------------------------------
# Redis / arq
# -----------------------------------------------------------------------------

# Redis DSN for arq's job queue
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Embeddings — sentence-transformers (local, in-process)
# -----------------------------------------------------------------------------

# HuggingFace model name. MUST produce 1024-dim embeddings to match the schema.
# If you change this, also update the vector(1024) column in the migration.
# Popular alternatives:
#   - BAAI/bge-base-en-v1.5   (768 dim — change migration to vector(768))
#   - intfloat/e5-large-v2     (1024 dim — compatible)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Torch device: "cpu", "cuda", or "mps" (Apple Silicon)
EMBEDDING_DEVICE=cpu

# Batch size when encoding chunks during ingestion
EMBEDDING_BATCH_SIZE=32

# -----------------------------------------------------------------------------
# Generation — local Ollama (no external LLM calls)
# -----------------------------------------------------------------------------

# Base URL of the local Ollama server
OLLAMA_BASE_URL=http://ollama:11434

# Ollama model tag. Must be pulled before first use.
# The ollama-init Docker service pulls this automatically.
# Alternatives: mistral:7b, phi3:mini, gemma2:9b
OLLAMA_MODEL=llama3.1:8b

# HTTP timeout for Ollama generation calls (seconds)
OLLAMA_TIMEOUT=120

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------

# Number of chunks returned by similarity search per query
TOP_K=8

# Minimum cosine similarity score to pass the confidence gate.
# Queries whose top result scores below this threshold return the refusal
# message without calling the LLM. Tune against your real data.
# Range: 0.0 (no gate) – 1.0 (exact match only)
SIMILARITY_THRESHOLD=0.5

# -----------------------------------------------------------------------------
# Chunking
# -----------------------------------------------------------------------------

# Target token count per chunk (aim for 256–512 range)
CHUNK_TARGET_TOKENS=384

# Overlap between consecutive chunks (~12% of target)
CHUNK_OVERLAP_TOKENS=46

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------

# Absolute path where uploaded raw files are stored.
# In Docker Compose, this is the mount point of the 'raw_files' volume.
RAW_FILES_DIR=/app/data/raw

# -----------------------------------------------------------------------------
# Auth / Tenancy (Phase 1 — simple mode)
# -----------------------------------------------------------------------------

# Fallback tenant UUID used when no tenant_id is supplied (local dev only).
# Must be a valid UUID v4. Leave blank to require tenant_id on every request.
DEFAULT_TENANT_ID=

# -----------------------------------------------------------------------------
# Supabase keys
# IMPORTANT: The service-role key MUST NOT be shared with API clients.
# It bypasses Row-Level Security and is used ONLY by the ingestion worker.
# -----------------------------------------------------------------------------

# Service-role key — worker only
SUPABASE_SERVICE_ROLE_KEY=

# Anonymous/public key — used by API clients (Phase 2 JWT verification)
SUPABASE_ANON_KEY=

# JWT secret for verifying Supabase tokens (min 32 chars)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters

# -----------------------------------------------------------------------------
# CORS (optional)
# Comma-separated list of allowed origins. Defaults to '*' (dev mode).
# Set to your frontend origin(s) in production.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# Citation validation
# -----------------------------------------------------------------------------

# Set to false to disable citation retry logic (useful during testing)
CITATION_RETRY_ENABLED=true

# =============================================================================
# Phase 2 — Hybrid Search & Local Reranker
# =============================================================================

# -----------------------------------------------------------------------------
# Reranker — cross-encoder model (sentence-transformers, runs locally)
# -----------------------------------------------------------------------------

# HuggingFace model name for the CrossEncoder reranker.
# Downloads on first start, cached in the hf_cache Docker volume (~1.3 GB).
# Alternatives: cross-encoder/ms-marco-MiniLM-L-6-v2 (faster, smaller)
RERANK_MODEL=BAAI/bge-reranker-large

# Number of top-reranked chunks passed to the LLM context window
RERANK_TOP_N=6

# -----------------------------------------------------------------------------
# Hybrid retrieval — vector + full-text search
# -----------------------------------------------------------------------------

# Candidate pool size for each search leg (vector AND full-text)
# before RRF fusion. Must be >= RERANK_TOP_N.
HYBRID_CANDIDATE_K=40

# RRF smoothing constant. Standard value from literature is 60.
# Higher = less influence of top-ranked documents from each leg.
RRF_K=60

# -----------------------------------------------------------------------------
# Confidence gate (Phase 2)
# Phase 1 used cosine similarity. Phase 2 uses the top CrossEncoder score.
# -----------------------------------------------------------------------------

# Refuse if top reranker score < this value.
#
# ⚠️  IMPORTANT: CrossEncoder logits are UNBOUNDED (not [0,1]).
# The default 0.0 is a conservative floor — negative logit means the
# model considers the top chunk clearly irrelevant.
#
# This threshold is CORPUS-DEPENDENT and MUST be tuned empirically
# against your actual documents and query patterns before production use.
# Start by logging rerank_scores from real queries, then pick a percentile
# cutoff that matches your acceptable false-positive/false-negative tradeoff.
GATE_RERANK_THRESHOLD=0.0

# -----------------------------------------------------------------------------
# MMR diversity pass (optional, default off)
# -----------------------------------------------------------------------------

# Set to true to enable Maximal Marginal Relevance after reranking.
# Reduces near-duplicate chunks from the same section in the LLM context.
# Toggle this to A/B test against plain top-N reranking.
MMR_ENABLED=false

# MMR relevance/diversity trade-off weight.
# 1.0 = pure relevance (no diversity filtering, same as MMR_ENABLED=false).
# 0.0 = maximum diversity (ignores relevance entirely).
# 0.5 is a balanced default.
MMR_LAMBDA=0.5

# =============================================================================
# Phase 4 — Multimodal Image Support (Local VLM)
# =============================================================================

# -----------------------------------------------------------------------------
# Vision-Language Model (Ollama)
# -----------------------------------------------------------------------------

# Ollama model tag for visual captioning and image Q&A.
# Optional — if not pulled, image captioning is skipped gracefully without breaking text RAG.
# Alternatives: llama3.2-vision:11b (~7GB), llama3.2-vision:3b (~2GB)
VLM_MODEL=llama3.2-vision

# HTTP timeout in seconds for VLM calls (image processing is slower than text)
VLM_TIMEOUT=300

# -----------------------------------------------------------------------------
# Image Extraction & Search
# -----------------------------------------------------------------------------

# Directory for extracted image files inside the container
IMAGES_DIR=/app/data/images

# Filter out extracted images smaller than this pixel dimension (icons/decorators)
IMAGE_MIN_SIZE_PX=50

# Max images extracted per PDF page
IMAGE_MAX_PER_PAGE=10

# Toggle image retrieval in hybrid search
IMAGE_SEARCH_ENABLED=true

# Toggle lightweight classification to auto-route follow-up queries to direct visual Q&A
IMAGE_REF_CLASSIFY_ENABLED=true

